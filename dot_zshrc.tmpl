{{ $os := .chezmoi.os -}}
{{ $environment := .environment -}}
export ZSH=$HOME/.oh-my-zsh
export TERM=xterm-256color
export LANG=en_US.UTF-8
export LC_ALL=$LANG
{{ if eq $os "darwin" -}}
export HOMEBREW_NO_ANALYTICS=1
{{ end -}}

plugins=(
  docker
  git
  {{ if eq $os "darwin" -}}brew{{ end }}
  common-aliases
  zsh-autosuggestions
  zsh-syntax-highlighting
  zsh-completions
)

ZSH_CACHE_DIR="${HOME}/.cache/zsh/"
ZSH_COMPDUMP="${HOME}/.cache/zsh/.zcompdump-${SHORT_HOST}-${ZSH_VERSION}"

# Create parent directory if not exists
[[ ! -d $HOME/.cache/zsh ]] && mkdir -p $HOME/.cache/zsh

source $ZSH/oh-my-zsh.sh

autoload -Uz zrecompile
autoload -Uz compinit
dump=$ZSH_COMPDUMP

# http://zsh.sourceforge.net/Doc/Release/Conditional-Expressions.html
if [[ -s "$dump(#qN.mh+24)" && (! -s "$dump.zwc" || "$dump" -nt "$dump.zwc") ]]; then
  compinit -i -d $ZSH_COMPDUMP
  zrecompile $ZSH_COMPDUMP
fi
compinit -C -d $ZSH_COMPDUMP

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[path]=none
ZSH_HIGHLIGHT_STYLES[path_prefix]=none
ZSH_HIGHLIGHT_STYLES[cursor]="bg-blue"

# Aliases
source ~/.aliases

# Starship
export STARSHIP_CONFIG=$HOME/.config/starship/starship.toml
eval "$(starship init zsh)"


# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('$HOME/miniconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
        . "$HOME/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="$HOME/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

# fnm
FNM_PATH="/root/.local/share/fnm"
if [ -d "$FNM_PATH" ]; then
  export PATH="$FNM_PATH:$PATH"
  eval "$(fnm env --shell bash)"
fi

PATH="$HOME/perl5/bin${PATH:+:${PATH}}"; export PATH;
PERL5LIB="$HOME/perl5/lib/perl5${PERL5LIB:+:${PERL5LIB}}"; export PERL5LIB;
PERL_LOCAL_LIB_ROOT="$HOME/perl5${PERL_LOCAL_LIB_ROOT:+:${PERL_LOCAL_LIB_ROOT}}"; export PERL_LOCAL_LIB_ROOT;
PERL_MB_OPT="--install_base \"$HOME/perl5\""; export PERL_MB_OPT;
PERL_MM_OPT="INSTALL_BASE=$HOME/perl5"; export PERL_MM_OPT;
export PATH="$HOME/.local/bin:$PATH"

{{ if ne $environment "container" -}}
# Docker
# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=($HOME/.docker/completions $fpath)
autoload -Uz compinit
compinit
# End of Docker CLI completions
{{ end -}}

{{ if eq $environment "container" -}}
PROMPT="${PROMPT}"$'\n'
{{ end -}}
